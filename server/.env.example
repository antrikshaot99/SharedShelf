# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=sharedshelf
DB_PORT=3306

# JWT Configuration
JWT_SECRET=your_secret_jwt_key_here

# Environment
NODE_ENV=development
PORT=5000

# Firebase Configuration
# Get this from Firebase Console > Project Settings
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# Admin Credentials
# Create this user in Firebase Authentication
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=your_admin_password_here

# Email Configuration (Gmail example - enable "Less secure app access" or use App Password)
# For Gmail: Use your email and create an App Password (2FA must be enabled)
# For other services: Update EMAIL_SERVICE to 'outlook', 'yahoo', etc.
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
